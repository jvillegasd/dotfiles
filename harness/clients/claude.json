{
  "permissions": {
    "deny": [
      "Read(**/.env*)",
      "Read(**/.dev.vars*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/config/database.yml)",
      "Read(**/config/credentials.json)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Edit(**/.env*)",
      "Edit(**/secrets/**)",
      "Edit(**/.ssh/**)",
      "Bash(git reset --hard:*)",
      "Bash(git reset --keep:*)",
      "Bash(git clean:*)",
      "Bash(git checkout --:*)",
      "Bash(git checkout -f:*)",
      "Bash(git restore:*)",
      "Bash(git worktree remove:*)",
      "Bash(git worktree prune:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "model": "opus",
  "effortLevel": "medium",
  "theme": "dark-ansi",
  "remoteControlAtStartup": false,
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/statusline.sh\""
  }
}
